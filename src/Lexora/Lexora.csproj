<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>Lexora</AssemblyName>
    <RootNamespace>Lexora</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Product>Lexora</Product>
    <Company>Shozi901</Company>
    <Authors>Shozi901</Authors>
    <Copyright>Copyright (c) 2026 Shozi901</Copyright>
    <PackageProjectUrl>https://github.com/shehroz901/Lexora</PackageProjectUrl>
    <Description>Lexora - offline AI writing assistant</Description>
    <Version>2.0.1</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
  </ItemGroup>

</Project>
